{
  "name": "quickcrawl",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/ui/styles/input.css -o ./public/styles.css --minify",
    "dev:css": "tailwindcss -i ./src/ui/styles/input.css -o ./public/styles.css --watch",
    "dev": "bun run build:css && bun run dev:css & bun --watch src/server.ts",
    "build": "bun run build:css && tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run dist/server.js",
    "dev:vercel": "vc dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "cheerio": "^1.2.0",
    "hono": "^4.11.8",
    "lucide": "^1.16.0",
    "p-pipe": "^4.0.0",
    "p-retry": "^7.1.1",
    "p-timeout": "^7.0.1",
    "pino": "^9.6.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.3.1",
    "@types/node": "^20.11.17",
    "@types/turndown": "^5.0.6",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
