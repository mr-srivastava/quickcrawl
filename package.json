{
  "name": "quickcrawl",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/ui/styles/input.css -o ./public/styles.css --minify",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "dev:css": "tailwindcss -i ./src/ui/styles/input.css -o ./public/styles.css --watch",
    "dev": "pnpm run build:css && pnpm run dev:css & tsx watch src/server.ts",
    "build": "pnpm run build:css && rolldown -c",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "dev:vercel": "vc dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "cheerio": "^1.2.0",
    "hono": "^4.11.8",
    "lucide": "^1.16.0",
    "p-retry": "^7.1.1",
    "pino": "^9.6.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "rolldown": "^1.2.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.7.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.20.0"
}
