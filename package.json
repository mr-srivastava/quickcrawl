{
  "name": "quickcrawl",
  "type": "module",
  "scripts": {
    "build:assets": "pnpm run build:client && pnpm run build:css",
    "build:client": "vite build",
    "build:css": "tailwindcss -i ./src/ui/styles/input.css -o ./public/styles.css --minify",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:client-size",
    "check:client-size": "node scripts/check-client-bundle-size.mjs",
    "dev:client": "vite build --watch",
    "dev:css": "tailwindcss -i ./src/ui/styles/input.css -o ./public/styles.css --watch",
    "dev:server": "tsx watch src/server.ts",
    "dev": "pnpm run build:assets && concurrently --kill-others-on-fail --names css,client,server 'pnpm run dev:css' 'pnpm run dev:client' 'pnpm run dev:server'",
    "build": "pnpm run build:assets && rolldown -c",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "dev:vercel": "vc dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@svelte-put/copy": "^4.0.0",
    "bits-ui": "^2.18.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dompurify": "3.2.4",
    "hono": "^4.11.8",
    "marked": "15.0.6",
    "p-retry": "^7.1.1",
    "pino": "^9.6.0",
    "svelte": "^5.56.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.28.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "rolldown": "^1.2.1",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.7.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.20.0"
}
