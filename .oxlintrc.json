{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "vitest"
  ],
  "rules": {
    "no-console": "error",
    "no-debugger": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "public/assets/**",
    "public/styles.css"
  ]
}
