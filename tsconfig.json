{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "$contracts": ["./src/contracts"],
      "$contracts/*": ["./src/contracts/*"],
      "$playground": ["./src/ui/islands/playground"],
      "$playground/*": ["./src/ui/islands/playground/*"]
    },
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist"
  },
  "exclude": ["node_modules"]
}
